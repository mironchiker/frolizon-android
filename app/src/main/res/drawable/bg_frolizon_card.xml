<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow/glow layer -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#22B39DDB" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Main card surface -->
    <item
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1A1426"
                android:centerColor="#12101E"
                android:endColor="#0E0C1A"
                android:type="linear" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#7E57C2" />
        </shape>
    </item>
</layer-list>
